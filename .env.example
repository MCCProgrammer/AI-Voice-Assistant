# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Any OpenRouter model with tool calling. Haiku is the fastest for voice;
# try anthropic/claude-sonnet-5.5 for harder questions.
# Free key without credits? Use a ":free" model, e.g. nvidia/nemotron-3-super-120b-a12b:free
MODEL=anthropic/claude-haiku-5.5

ASSISTANT_NAME=Jarvis

# Neural voice for replies (run `edge-tts --list-voices` to see all of them)
VOICE=en-GB-RyanNeural

# Language you speak to it in
LANGUAGE=en-US

# Say "Hey Jarvis" to start talking (on/off)
WAKE_WORD=on
WAKE_THRESHOLD=0.4

# Speech-to-text: "google" (free, no key) or "openrouter" (uses STT_MODEL below)
STT=google
STT_MODEL=google/gemini-3.8-flash
